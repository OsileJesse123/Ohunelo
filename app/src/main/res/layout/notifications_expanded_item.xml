<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="notification"
            type="com.jesse.ohunelo.data.model.Notification" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorPrimary"
        >


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/grid_2"
            android:paddingVertical="@dimen/grid_2"
            android:clipToPadding="false"
            >

            <TextView
                android:id="@+id/notification_type_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/textAppearanceHeadline5"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:uiText="@{notification.notificationTypeUiText()}"
                tools:text="Food Joke" />

            <ImageView
                android:id="@+id/close_image"
                android:layout_width="@dimen/grid_3"
                android:layout_height="@dimen/grid_3"
                android:contentDescription="@string/close_expanded_notification"
                android:src="@drawable/close_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnPrimary" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_0dp"
                app:layout_constraintHeight_percent=".85"
                android:layout_marginVertical="@dimen/grid_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/notification_type_title"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/notification_type_icon"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/notification_type_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent=".5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias=".0"
                        app:layout_constraintWidth_percent=".5"
                        app:tint="?attr/colorOnPrimary"
                        app:uiDrawable="@{notification.notificationTypeIcon()}"
                        tools:src="@drawable/food_joke_icon" />

                    <TextView
                        android:id="@+id/notification_content"
                        style="?attr/textAppearanceBody1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_1"
                        android:text="@{notification.notificationContent}"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnPrimary"
                        tools:text="In the grand tapestry of existence, every individual embarks on a unique voyage—a journey of self-discovery. It's a pilgrimage through the depths of one's being, an odyssey that unveils the layers of the self, revealing truths obscured by the veils of societal expectations, personal fears, and inherited beliefs.

This expedition often begins in the quiet recesses of contemplation, where one dares to question the narratives that have been woven into the fabric of their identity. It's a courageous act, for it requires facing the unknown, venturing into the uncharted territories of the mind and soul. Yet, it's this very act of questioning that ignites the spark of transformation, setting the wheels of self-discovery in motion.

" />
                </LinearLayout>
            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>