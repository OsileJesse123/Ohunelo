<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/_5dp"
        android:layout_marginTop="@dimen/grid_2"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/grid_2"
            android:paddingVertical="@dimen/grid_4"
            >

            <TextView
                android:id="@+id/permission_request"
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:text="@string/permission_request"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/permsission_rationale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permission_rationale"
                android:textAppearance="?attr/textAppearanceBody2"
                android:layout_marginTop="@dimen/grid_0_5"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/permission_request"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grant_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:layout_marginTop="@dimen/grid_0_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/permsission_rationale" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>