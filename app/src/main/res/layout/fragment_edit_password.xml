<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.jesse.ohunelo.presentation.viewmodels.EditPasswordViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.ui.fragment.profile.EditPasswordFragment">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/grid_1"
            android:indeterminateTint="?attr/colorOnSecondary"
            app:layout_constraintBottom_toBottomOf="@+id/update_button"
            app:layout_constraintEnd_toEndOf="@+id/update_button"
            app:layout_constraintStart_toStartOf="@+id/update_button"
            app:layout_constraintTop_toTopOf="@+id/update_button" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/edit_password_tool_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIconTint="?attr/colorSecondaryVariant"
            app:titleTextColor="?attr/colorSecondaryVariant"
            app:titleTextAppearance="?attr/textAppearanceHeadline2"
            android:background="?attr/colorBackgroundCustom"
            app:titleCentered="true"
            app:title="@string/edit_password"
            app:navigationIcon="@drawable/arrow_back_icon"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/email_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:text="@string/password"
            android:textColor="?attr/colorSecondaryVariant"
            android:layout_marginHorizontal="@dimen/grid_2"
            android:layout_marginTop="@dimen/grid_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_password_tool_bar" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/enter_password_input_layout"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            app:passwordToggleDrawable="@drawable/show_password_selector"
            app:passwordToggleEnabled="true"
            app:boxCornerRadiusBottomEnd="@dimen/_10dp"
            app:boxCornerRadiusBottomStart="@dimen/_10dp"
            app:boxCornerRadiusTopEnd="@dimen/_10dp"
            app:boxCornerRadiusTopStart="@dimen/_10dp"
            app:startIconDrawable="@drawable/lock_icon"
            app:layout_constraintTop_toBottomOf="@id/email_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:layout_marginTop="@dimen/grid_1_5"
            android:layout_marginHorizontal="@dimen/grid_2"
            app:boxStrokeWidth="1dp"
            app:boxStrokeColor="@color/box_stroke_color_state"
            app:hintEnabled="false"
            app:errorEnabled="true"
            app:errorMessageText="@{viewModel.editPasswordUiState.passwordError}"
            android:textColorHint="@color/orange_100"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/enter_password_edit_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="textPassword"
                android:hint="@string/enter_new_password"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="@dimen/_12sp"
                android:importantForAutofill="no"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- app:buttonTextTransparency="@{!viewModel.editPasswordUiState.loading}" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_button"
            android:layout_width="@dimen/_0dp"
            android:layout_height="@dimen/grid_8"
            android:layout_marginHorizontal="@dimen/grid_2"
            android:layout_marginTop="@dimen/grid_4"
            android:backgroundTint="?attr/colorSecondary"
            android:text="@string/update"
            app:cornerRadius="@dimen/_15dp"

            android:enabled="@{!viewModel.editPasswordUiState.loading}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/enter_password_input_layout" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>